{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./apps/cli/**)",
      "Edit(./apps/cli/**)",
      "Write(./apps/cli/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-pr-template.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
